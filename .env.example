# ==========================================
# GOOGLE GEMINI API CONFIGURATION
# ==========================================
# Optional: used for AI-powered name, trait, portrait, and backstory generation.
# Get your API key from: https://aistudio.google.com/app/apikey

# Preferred (Vite convention)
VITE_GEMINI_API_KEY=

# Supported for compatibility with older setups
GEMINI_API_KEY=

# ==========================================
# OPENROUTER API CONFIGURATION
# ==========================================
# Optional: used for provider-aware AI generation and OpenRouter model refreshes.
# Get your API key from: https://openrouter.ai/

VITE_OPENROUTER_API_KEY=

# Supported for compatibility with older setups
OPENROUTER_API_KEY=

# ==========================================
# OPENCODE GO API CONFIGURATION
# ==========================================
# Optional: used for OpenCode Go provider-aware AI generation and model refreshes.

VITE_OPENCODE_GO_API_KEY=
OPENCODE_GO_API_KEY=

# ==========================================
# DEEPSEEK API CONFIGURATION
# ==========================================
# Optional: used for DeepSeek provider-aware AI generation and model refreshes.

VITE_DEEPSEEK_API_KEY=
DEEPSEEK_API_KEY=

# If you do not set a key, the app will still work; AI features will be disabled.

# Z.ai / Zhipu Coding Plan
VITE_ZHIPU_API_KEY=
ZHIPU_API_KEY=
VITE_ZAI_API_KEY=
ZAI_API_KEY=

# xAI Grok (API key mode; OAuth uses Settings device login)
VITE_XAI_API_KEY=
XAI_API_KEY=
